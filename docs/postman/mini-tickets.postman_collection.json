{
  "info": {
    "name": "Mini Tickets",
    "description": "Mini Tickets API (Classora technical test). Select an environment to choose the profile: the collection pre-request script sends X-User-Team and X-User-Permissions. Start the backend with `uv run uvicorn tickets.main:create_app --factory` from `backend/`. Tickets come from the deterministic seed: ids are the same on every start, changes are lost on restart.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Simulated identity of the selected environment (Developer, Team lead, Security, Anonymous).",
          "const team = pm.environment.get('team');",
          "const permissions = pm.environment.get('permissions');",
          "if (team) { pm.request.headers.upsert({ key: 'X-User-Team', value: team }); }",
          "if (permissions) { pm.request.headers.upsert({ key: 'X-User-Permissions', value: permissions }); }",
          "",
          "// Dates relative to today (UTC), for the due date requests.",
          "const day = 24 * 60 * 60 * 1000;",
          "const isoDate = (ms) => new Date(ms).toISOString().slice(0, 10);",
          "pm.variables.set('today', isoDate(Date.now()));",
          "pm.variables.set('tomorrow', isoDate(Date.now() + day));",
          "pm.variables.set('yesterday', isoDate(Date.now() - day));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Team and permissions from the headers. Anonymous \u2192 401."
          }
        }
      ]
    },
    {
